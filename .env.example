# ==== Application ====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme

# ==== Backend / API ====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==== Database (PostgreSQL) ====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clinical_reviewer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5432/clinical_reviewer

# ==== File Storage ====
UPLOAD_MAX_SIZE_MB=25
UPLOAD_STORAGE_DIR=./backend/storage

# ==== AI / ML Provider (provider-agnostic; do not hard-code a single vendor) ====
# AI_PROVIDER=placeholder (default): no real AI runs; analyses fail cleanly
#   with AI_EXTRACTION_FAILED instead of fabricating a report.
# AI_PROVIDER=openai: real extraction/generation via an OpenAI-compatible
#   /chat/completions API. Requires AI_API_KEY. Works against OpenAI itself
#   (leave AI_API_BASE_URL empty) or any compatible endpoint (Azure OpenAI,
#   OpenRouter, a self-hosted server, ...) by setting AI_API_BASE_URL.
AI_PROVIDER=placeholder
AI_MODEL_NAME=gpt-4o-mini
AI_API_KEY=changeme
AI_API_BASE_URL=

# ==== OCR (local/offline; see docs/decisions/007-ocr.md) ====
OCR_ENGINE=tesseract

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:8000/api
